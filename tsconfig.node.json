{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "vite.renderer.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // tests/ui needs the DOM types as well: see tsconfig.uitests.json.
  "exclude": ["tests/ui/**"]
}
